# 1. Use a slim, official Python image for a smaller container size
FROM python:3.9-slim

# 2. Set the working directory in the container
WORKDIR /app

# 3. Upgrade pip
RUN pip install --no-cache-dir --upgrade pip

# 4. Copy *only* the requirements file to leverage Docker layer caching
# This step is only re-run if requirements.txt changes
COPY ./requirements.txt /app/requirements.txt

# 5. Install Python dependencies
# Gunicorn and Uvicorn MUST be in your requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# 6. Copy your application code into the container
# This assumes your code is in a folder named 'app'
COPY ./fast_api_app.py /app/fast_api_app.py

# 7. Expose the port the container will run on
EXPOSE 8080

# 8. Run the application with a production server (Gunicorn + Uvicorn)
# This is the most important change.
# It assumes your FastAPI instance in 'main.py' is named 'app'.
# We bind to 0.0.0.0 so it's accessible from outside the container.
CMD ["gunicorn", "-w", "4", "-k", "uvicorn.workers.UvicornWorker", "fast_api_app:app", "--bind", "0.0.0.0:8080"]